@model List<HostApplication>
@{
    ViewData["Title"] = "My Properties";
}

<!-- Empty form for deleting properties -->
<form id="delete-form" asp-action="Delete" method="post"></form>
<div class="mb-4 flex flex-wrap items-center justify-end gap-3">
    <!-- Link to add new property -->
    <a asp-action="Create" class="btn-primary">+ Add New Property</a>

    <!-- Selection controls -->
    @if (Model.Any())
    {
        <button type="button" data-select-toggle class="btn-secondary">Remove Property</button>

        <div data-select-actions class="hidden">
            <div class="flex items-center gap-3">
                <button type="submit" form="delete-form" class="btn-primary">Delete selected</button>
                <button type="button" data-select-cancel class="btn-secondary">Cancel</button>
            </div>
        </div>
    }
</div>
<!-- Empty state -->
@if (!Model.Any())
{
    <div class="card text-center text-gray-500">You don't have any properties yet.</div>
}
<!-- Property list -->
<div class="space-y-4">
    @foreach (var application in Model)
    {
        var property = application.Property;
        var cover = property.Images.FirstOrDefault();

        <div class="card flex flex-col gap-4 p-4 sm:flex-row">
            <input type="checkbox" form="delete-form" name="ids" value="@property.Id" data-select-box
                   aria-label="Select @property.Title for removal"
                   class="hidden h-5 w-5 shrink-0 self-center rounded border-gray-300 text-brand focus:ring-brand" />
            
            @if (cover is not null)
            {
                <a asp-area="" asp-controller="Properties" asp-action="Details" asp-route-id="@property.Id"
                   class="group block shrink-0 overflow-hidden rounded-xl sm:w-52" title="View public listing">
                    <img src="~/uploads/properties/@cover.ImageUrl" alt="@property.Title" class="h-32 w-full object-cover transition-transform duration-300 group-hover:scale-105" />
                </a>
            }

            <div class="flex flex-1 flex-col justify-between gap-3">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <h2 class="text-lg font-semibold">@property.Title</h2>
                        <p class="text-sm text-gray-500">@property.City &middot; @property.PropertyType</p>
                        <p class="mt-1 text-sm font-medium">R @property.PricePerNight.ToString("N2") <span class="font-normal text-gray-500">/ night</span></p>
                    </div>
                    <div class="flex items-center gap-2">
                        <partial name="_ApplicationStatusBadge" model="application.Status" />
                        @if (application.Status == ApplicationStatus.Approved)
                        {
                            var setupDone = property.CheckInProcess is not null;
                            var badgeText = !setupDone ? "Setup required" : property.IsActive ? "Active" : "Inactive";
                            var badgeClass = !setupDone ? "bg-amber-100 text-amber-800" : property.IsActive ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-600";
                            <span class="rounded-full px-3 py-1 text-xs font-semibold @badgeClass">@badgeText</span>
                        }
                    </div>
                </div>

                @if (application.Status == ApplicationStatus.Rejected && !string.IsNullOrWhiteSpace(application.RejectionReason))
                {
                    <div class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800">
                        <span class="font-semibold">Reason:</span> @application.RejectionReason
                    </div>
                }

                @if (application.Status == ApplicationStatus.Approved)
                {
                    var hasSetup = property.CheckInProcess is not null;

                    if (!hasSetup)
                    {
                        <p class="text-sm text-amber-700">Set up check-in to list this property on StayBNB.</p>
                    }

                    <div class="flex items-center justify-end gap-2">
                        <a asp-controller="CheckInSetup" asp-action="Edit" asp-route-id="@property.Id" class="@(hasSetup ? "btn-secondary" : "btn-primary")">
                            @(hasSetup ? "Check-in Setup" : "Set up check-in")
                        </a>

                        @if (hasSetup)
                        {
                            <form asp-action="ToggleActive" asp-route-id="@property.Id" method="post">
                                @if (property.IsActive)
                                {
                                    <button type="submit" class="btn-primary">Deactivate</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn-secondary">Activate</button>
                                }
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>
