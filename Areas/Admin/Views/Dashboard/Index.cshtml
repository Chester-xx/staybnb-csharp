@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard Overview";

    // Define the stats to display in the dashboard
    var stats = new (string Label, int Value, string Note)[]
    {
        ("Total Users", Model.TotalUsers, "Registered accounts"),
        ("Pending Host Apps", Model.PendingApplications, "Require review"),
        ("Active Properties", Model.ActiveProperties, "Listings available"),
        ("Total Bookings", Model.TotalBookings, $"{Model.PendingBookings} pending"),
        ("Approved Hosts", Model.ApprovedHosts, "Active hosts")
    };
}

<!-- Dashboard stats -->
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-5">
    @foreach (var stat in stats)
    {
        <div class="card">
            <p class="text-sm text-gray-500">@stat.Label</p>
            <p class="mt-1 text-3xl font-bold">@stat.Value</p>
            <p class="mt-1 text-xs text-gray-400">@stat.Note</p>
        </div>
    }
</div>

<!-- Recent activity and host applications -->
<div class="mt-6 grid grid-cols-1 gap-6 xl:grid-cols-2">
    <!-- Recent activity -->
    <div class="card">
        <h2 class="mb-4 text-lg font-semibold">Recent Activity</h2>
        @if (!Model.RecentActivity.Any())
        {
            <p class="text-sm text-gray-500">No activity yet.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="text-xs uppercase text-gray-500">
                        <tr><th class="pb-2">User</th><th class="pb-2">Action</th><th class="pb-2">Date</th></tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var log in Model.RecentActivity)
                        {
                            <tr>
                                <td class="py-2 pr-3">@log.User.FullName<div class="text-xs text-gray-400">@log.User.Email</div></td>
                                <td class="py-2 pr-3">@log.Action</td>
                                <td class="py-2 whitespace-nowrap text-gray-500">@log.CreatedAt.ToLocalTime().ToString("d MMM HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Recent host applications -->
    <div class="card">
        <div class="mb-4 flex items-center justify-between">
            <h2 class="text-lg font-semibold">Recent Host Applications</h2>
            <a asp-controller="HostRequests" asp-action="Index" class="text-sm font-medium text-brand hover:underline">View all</a>
        </div>
        <!-- None -->
        @if (!Model.RecentApplications.Any())
        {
            <p class="text-sm text-gray-500">No applications yet.</p>
        }
        else
        {
            <!-- Applications -->
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="text-xs uppercase text-gray-500">
                        <tr><th class="pb-2">Applicant</th><th class="pb-2">Property</th><th class="pb-2">Status</th><th class="pb-2"></th></tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var application in Model.RecentApplications)
                        {
                            <tr>
                                <td class="py-2 pr-3">@application.ApplicationUser.FullName<div class="text-xs text-gray-400">@application.ApplicationUser.Email</div></td>
                                <td class="py-2 pr-3">@application.Property.Title</td>
                                <td class="py-2 pr-3"><partial name="_ApplicationStatusBadge" model="application.Status" /></td>
                                <td class="py-2"><a asp-controller="HostRequests" asp-action="Details" asp-route-id="@application.Id" class="font-medium text-brand hover:underline">View</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
