@{
    string Cls(string? navClass) => navClass == "active"
        ? "bg-rose-50 font-semibold text-brand"
        : "text-gray-700 hover:bg-gray-50";
}
<nav class="card space-y-1 p-3">
    <a id="profile" asp-page="./Index" class="block rounded-lg px-3 py-2 text-sm @Cls(ManageNavPages.IndexNavClass(ViewContext))">Profile</a>
    <a id="change-password" asp-page="./ChangePassword" class="block rounded-lg px-3 py-2 text-sm @Cls(ManageNavPages.ChangePasswordNavClass(ViewContext))">Password</a>
</nav>
