@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="mx-auto max-w-md">
    <div class="card space-y-4 text-center">
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <h1 class="text-2xl font-bold">Log out</h1>
            <p class="text-sm text-gray-500">Are you sure you want to log out?</p>
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button type="submit" class="btn-primary w-full">Log out</button>
            </form>
        }
        else
        {
            <h1 class="text-2xl font-bold">You're logged out</h1>
            <p class="text-sm text-gray-500">Thanks for visiting StayBNB.</p>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn-primary w-full">Back to home</a>
        }
    </div>
</div>
