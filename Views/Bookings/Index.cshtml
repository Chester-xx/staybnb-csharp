@model List<Booking>
@using System.Globalization
@using staybnb_csharp.Models.Enums
@{
    ViewData["Title"] = "My Bookings";

    string Badge(BookingStatus status) => status switch
    {
        BookingStatus.Approved => "bg-green-100 text-green-800",
        BookingStatus.CheckedIn => "bg-blue-100 text-blue-800",
        BookingStatus.Rejected or BookingStatus.Cancelled => "bg-red-100 text-red-800",
        BookingStatus.Completed => "bg-gray-100 text-gray-700",
        _ => "bg-amber-100 text-amber-800"
    };
}

<div class="mx-auto max-w-4xl">
    <h1 class="mb-6 text-3xl font-bold">My Bookings</h1>

    @if (!Model.Any())
    {
        <div class="card text-center text-gray-500">
            You haven't made any bookings yet.
            <a asp-controller="Home" asp-action="Index" class="font-medium text-brand hover:underline">Find a place to stay</a>
        </div>
    }

    <div class="space-y-4">
        @foreach (var booking in Model)
        {
            var cover = booking.Property.Images.FirstOrDefault();

            <div class="card flex flex-col gap-4 p-4 sm:flex-row">
                @if (cover is not null)
                {
                    <a asp-controller="Properties" asp-action="Details" asp-route-id="@booking.PropertyId" class="block overflow-hidden rounded-xl sm:w-52">
                        <img src="~/uploads/properties/@cover.ImageUrl" alt="@booking.Property.Title" class="h-32 w-full object-cover" />
                    </a>
                }
                <div class="flex flex-1 flex-col justify-between gap-2">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div>
                            <h2 class="text-lg font-semibold">@booking.Property.Title</h2>
                            <p class="text-sm text-gray-500">@booking.Property.City</p>
                        </div>
                        <span class="rounded-full px-3 py-1 text-xs font-semibold @Badge(booking.Status)">@booking.Status</span>
                    </div>
                    <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
                        <p>@booking.CheckInDate.ToString("d MMM") &ndash; @booking.CheckOutDate.ToString("d MMM yyyy") &middot; @booking.NumberOfGuests guest@(booking.NumberOfGuests == 1 ? "" : "s")</p>
                        <p class="font-semibold">R @booking.TotalPrice.ToString("N2", CultureInfo.InvariantCulture)</p>
                    </div>

                    @if (booking.Status is BookingStatus.Approved or BookingStatus.CheckedIn)
                    {
                        var checkInLabel = booking.Status == BookingStatus.CheckedIn ? "View check-in" : booking.GuestCheckIn?.Status switch
                        {
                            null => "Start check-in",
                            CheckInStatus.InProgress => "Continue check-in",
                            _ => "View check-in"
                        };
                        <div class="flex justify-end">
                            <a asp-controller="CheckIn" asp-action="Index" asp-route-id="@booking.Id" class="btn-primary">@checkInLabel</a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
