@model CheckInWizardViewModel
@using staybnb_csharp.Models.Enums
@{
    var booking = Model.Booking;
    ViewData["Title"] = "Check-in";

    var steps = new[] { "House rules", "Documents", "Review & submit" };
}

<div class="mx-auto max-w-2xl">
    <div class="mb-4"><a asp-controller="Bookings" asp-action="Index" class="text-sm font-medium text-gray-600 hover:text-brand">&larr; Back to my bookings</a></div>

    <h1 class="text-3xl font-bold">@Model.Booking.Property.CheckInProcess!.Title</h1>
    <p class="mb-6 mt-1 text-sm text-gray-500">
        @booking.Property.Title &middot; @booking.CheckInDate.ToString("d MMM") &ndash; @booking.CheckOutDate.ToString("d MMM yyyy")
    </p>

    @if (Model.Step <= 3)
    {
        <ol class="mb-6 flex items-center gap-2 text-sm">
            @for (var i = 0; i < steps.Length; i++)
            {
                var number = i + 1;
                var state = number == Model.Step ? "bg-brand text-white" : number < Model.Step ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-500";
                <li class="flex items-center gap-2">
                    <span class="flex h-7 w-7 items-center justify-center rounded-full text-xs font-semibold @state">@number</span>
                    <span class="@(number == Model.Step ? "font-semibold" : "text-gray-500")">@steps[i]</span>
                    @if (number < steps.Length) { <span class="mx-1 text-gray-300">&mdash;</span> }
                </li>
            }
        </ol>
    }

    @switch (Model.Step)
    {
        case 1:
            <div class="card space-y-4">
                <h2 class="text-lg font-semibold">House rules</h2>
                @if (Model.Settings.Rules.Any())
                {
                    <ul class="list-disc space-y-1 pl-5 text-sm text-gray-700">
                        @foreach (var rule in Model.Settings.Rules)
                        {
                            <li>@rule</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-sm text-gray-500">The host has not listed any specific house rules.</p>
                }

                <form asp-action="AcceptRules" asp-route-id="@booking.Id" method="post" class="space-y-4 border-t border-gray-100 pt-4">
                    <label class="flex items-start gap-2 text-sm">
                        <input type="checkbox" name="accepted" value="true" class="mt-0.5 rounded border-gray-300 text-brand focus:ring-brand" />
                        I have read and agree to follow the house rules.
                    </label>
                    <button type="submit" class="btn-primary w-full">Continue</button>
                </form>
            </div>
            break;

        case 2:
            <div class="card space-y-4">
                <h2 class="text-lg font-semibold">Upload your documents</h2>
                <p class="text-sm text-gray-500">JPG, PNG, WebP or PDF, up to 5 MB each. Only you and the host can view them.</p>

                @foreach (var slot in Model.Slots)
                {
                    <div class="rounded-xl border border-gray-200 p-4">
                        <div class="flex items-center justify-between gap-3">
                            <p class="font-medium">@slot.DocumentType</p>
                            @if (slot.Document is not null)
                            {
                                <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-800">Uploaded</span>
                            }
                        </div>

                        <form asp-action="UploadDocument" asp-route-id="@booking.Id" method="post" enctype="multipart/form-data" class="mt-3 flex flex-wrap items-center gap-3">
                            <input type="hidden" name="documentType" value="@slot.DocumentType" />
                            <input type="file" name="file" required accept="image/jpeg,image/png,image/webp,application/pdf"
                                   class="min-w-0 flex-1 text-sm text-gray-700 file:mr-3 file:rounded-lg file:border-0 file:bg-gray-100 file:px-3 file:py-2 file:text-sm file:font-semibold hover:file:bg-gray-200" />
                            <button type="submit" class="btn-secondary px-3 py-2">@(slot.Document is null ? "Upload" : "Replace")</button>
                        </form>

                        @if (slot.Document is not null)
                        {
                            <a asp-controller="GuestDocuments" asp-action="Open" asp-route-id="@slot.Document.Id" target="_blank"
                               class="mt-2 inline-block text-sm font-medium text-brand hover:underline">View uploaded file</a>
                        }
                    </div>
                }

                <div class="flex items-center justify-between border-t border-gray-100 pt-4">
                    <a asp-action="Index" asp-route-id="@booking.Id" asp-route-step="1" class="text-sm font-medium text-gray-600 hover:text-brand">&larr; Rules</a>
                    @if (Model.AllDocumentsUploaded)
                    {
                        <a asp-action="Index" asp-route-id="@booking.Id" asp-route-step="3" class="btn-primary">Continue to review</a>
                    }
                    else
                    {
                        <span class="text-sm text-gray-500">Upload every document to continue.</span>
                    }
                </div>
            </div>
            break;

        case 3:
            <div class="card space-y-4">
                <h2 class="text-lg font-semibold">Review and submit</h2>
                <ul class="divide-y divide-gray-100 text-sm">
                    @foreach (var slot in Model.Slots)
                    {
                        <li class="flex items-center justify-between py-2">
                            <span>@slot.DocumentType</span>
                            <a asp-controller="GuestDocuments" asp-action="Open" asp-route-id="@slot.Document!.Id" target="_blank" class="font-medium text-brand hover:underline">View</a>
                        </li>
                    }
                </ul>
                <p class="text-sm text-gray-500">Once you submit, the host will verify your documents and you can't change them.</p>

                <div class="flex items-center justify-between border-t border-gray-100 pt-4">
                    <a asp-action="Index" asp-route-id="@booking.Id" asp-route-step="2" class="text-sm font-medium text-gray-600 hover:text-brand">&larr; Documents</a>
                    <form asp-action="Submit" asp-route-id="@booking.Id" method="post">
                        <button type="submit" class="btn-primary">Submit check-in</button>
                    </form>
                </div>
            </div>
            break;

        default:
            var verified = booking.Status == BookingStatus.CheckedIn || Model.CheckIn?.Status == CheckInStatus.Verified;
            <div class="card text-center">
                @if (verified)
                {
                    <p class="text-2xl font-bold text-green-700">You're checked in</p>
                    <p class="mt-2 text-sm text-gray-600">The host has verified your documents. Enjoy your stay!</p>
                }
                else
                {
                    <p class="text-2xl font-bold">Check-in submitted</p>
                    <p class="mt-2 text-sm text-gray-600">Your documents are waiting for the host to verify them. You'll get a notification when it's done.</p>
                }
            </div>
            break;
    }
</div>
