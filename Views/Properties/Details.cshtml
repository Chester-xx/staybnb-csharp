@model PropertyDetailsViewModel
@using System.Globalization
@{
    var property = Model.Property;
    ViewData["Title"] = property.Title;

    var inv = CultureInfo.InvariantCulture;
    var today = DateTime.Today;
    var images = property.Images.ToList();
}

<div class="mx-auto max-w-6xl">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold tracking-tight">@property.Title</h1>
            <p class="mt-1 text-sm text-gray-500">@property.Address, @property.City &middot; @property.PropertyType</p>
        </div>
        <div class="text-right text-sm">
            <p class="font-semibold">Hosted by @property.Host.FirstName</p>
            <span class="rounded-full bg-rose-100 px-2.5 py-0.5 text-xs font-semibold text-brand">Verified Host</span>
        </div>
    </div>

    @if (!property.IsActive)
    {
        <div class="mt-4 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-800">This property is not currently listed. Only you and administrators can see this page.</div>
    }

    <div class="mt-6 grid grid-cols-1 gap-2 overflow-hidden rounded-2xl md:grid-cols-4 md:grid-rows-2">
        @for (var i = 0; i < Math.Min(images.Count, 5); i++)
        {
            var span = i == 0 ? "md:col-span-2 md:row-span-2" : string.Empty;
            <div class="group overflow-hidden bg-gray-200 @span">
                <img src="~/uploads/properties/@images[i].ImageUrl" alt="@property.Title photo @(i + 1)"
                     class="h-full max-h-96 w-full object-cover transition-transform duration-300 group-hover:scale-105 md:max-h-none" />
            </div>
        }
    </div>

    <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-3">
        <div class="lg:col-span-2">
            <h2 class="text-xl font-semibold">About this place</h2>
            <p class="mt-3 whitespace-pre-line text-gray-700">@property.Description</p>
        </div>

        <aside>
            <div class="card space-y-4"
                 data-booking-card
                 data-price="@property.PricePerNight.ToString(inv)"
                 data-cleaning-percent="@Model.CleaningFeePercent.ToString(inv)"
                 data-service-percent="@Model.ServiceFeePercent.ToString(inv)"
                 data-booked="@Model.BookedRangesJson">
                <p class="text-2xl font-bold">R @property.PricePerNight.ToString("N2", inv) <span class="text-base font-normal text-gray-500">/ night</span></p>

                @if (Model.CanBook)
                {
                    <form asp-controller="Bookings" asp-action="Create" method="post" class="space-y-4">
                        <input type="hidden" name="PropertyId" value="@property.Id" />

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label for="CheckInDate" class="form-label">Check-in</label>
                                <input id="CheckInDate" name="CheckInDate" type="date" required
                                       min="@today.ToString("yyyy-MM-dd")" value="@today.ToString("yyyy-MM-dd")" class="form-input" />
                            </div>
                            <div>
                                <label for="CheckOutDate" class="form-label">Check-out</label>
                                <input id="CheckOutDate" name="CheckOutDate" type="date" required
                                       min="@today.AddDays(1).ToString("yyyy-MM-dd")" value="@today.AddDays(1).ToString("yyyy-MM-dd")" class="form-input" />
                            </div>
                        </div>

                        <div>
                            <label for="NumberOfGuests" class="form-label">Guests</label>
                            <input id="NumberOfGuests" name="NumberOfGuests" type="number" min="1" max="10" value="1" required class="form-input" />
                        </div>

                        <p data-booking-error class="hidden text-sm text-red-600"></p>

                        <dl class="space-y-2 border-t border-gray-100 pt-4 text-sm">
                            <div class="flex justify-between"><dt data-line="subtotal-label" class="text-gray-600"></dt><dd data-line="subtotal"></dd></div>
                            <div class="flex justify-between"><dt class="text-gray-600">Cleaning fee (@Model.CleaningFeePercent.ToString("0.##", inv)%)</dt><dd data-line="cleaning"></dd></div>
                            <div class="flex justify-between"><dt class="text-gray-600">Service fee (@Model.ServiceFeePercent.ToString("0.##", inv)%)</dt><dd data-line="service"></dd></div>
                            <div class="flex justify-between border-t border-gray-100 pt-2 text-base font-semibold"><dt>Total</dt><dd data-line="total"></dd></div>
                        </dl>

                        <button type="submit" data-booking-submit class="btn-primary w-full disabled:cursor-not-allowed disabled:opacity-50">Request to book</button>
                        <p class="text-center text-xs text-gray-500">The host reviews your request. You won't be charged yet.</p>
                    </form>

                    @if (Model.BookedRanges.Any())
                    {
                        <div class="rounded-lg bg-gray-50 px-4 py-3 text-xs text-gray-600">
                            <p class="mb-1 font-semibold text-gray-700">Already booked</p>
                            <ul class="space-y-0.5">
                                @foreach (var range in Model.BookedRanges)
                                {
                                    <li>@DateTime.Parse(range.From).ToString("d MMM yyyy") &ndash; @DateTime.Parse(range.To).ToString("d MMM yyyy")</li>
                                }
                            </ul>
                        </div>
                    }

                    <a asp-controller="Messages" asp-action="Compose" asp-route-to="@property.HostId" asp-route-about="@property.Title"
                       class="btn-secondary w-full">Message the host</a>
                }
                else
                {
                    <p class="rounded-lg bg-gray-50 px-4 py-3 text-sm text-gray-600">@Model.BookingBlockedReason</p>
                    @if (Model.NeedsLogin)
                    {
                        <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path" class="btn-primary w-full">Log in to book</a>
                    }
                }
            </div>
        </aside>
    </div>
</div>
