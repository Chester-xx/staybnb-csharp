@using Microsoft.AspNetCore.Identity
@using staybnb_csharp.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var displayName = user is null || string.IsNullOrWhiteSpace(user.FullName) ? User.Identity?.Name : user.FullName;

    <div class="relative">
        <button type="button" data-toggle="user-menu"
                class="flex items-center gap-2 rounded-full border border-gray-300 px-4 py-2 text-sm font-medium hover:shadow">
            <span>@displayName</span>
            <span aria-hidden="true">&#9662;</span>
        </button>
        <div id="user-menu" data-menu class="absolute right-0 z-20 mt-2 hidden w-48 rounded-xl border border-gray-200 bg-white py-2 shadow-lg">
            <a asp-area="Identity" asp-page="/Account/Manage/Index" class="block px-4 py-2 text-sm hover:bg-gray-50">Account</a>
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" class="block w-full px-4 py-2 text-left text-sm hover:bg-gray-50">Logout</button>
            </form>
        </div>
    </div>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Login" class="text-sm font-medium text-gray-700 hover:text-brand">Login</a>
    <a asp-area="Identity" asp-page="/Account/Register" class="btn-primary">Register</a>
}
