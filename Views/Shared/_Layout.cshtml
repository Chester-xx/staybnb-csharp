<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StayBNB</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-gray-950 font-sans text-gray-900">
    <header class="border-b border-gray-200 bg-white">
        <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="text-2xl font-bold tracking-tight text-brand">StayBNB</a>
            <nav class="flex items-center gap-4">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="text-sm font-medium text-gray-700 hover:text-brand">Home</a>
                @if (User.IsInRole("Guest"))
                {
                    <a asp-area="" asp-controller="Bookings" asp-action="Index" class="text-sm font-medium text-gray-700 hover:text-brand">My Bookings</a>
                    <a asp-area="" asp-controller="HostApplication" asp-action="Apply" class="text-sm font-medium text-gray-700 hover:text-brand">Become a Host</a>
                }
                @if (User.IsInRole("Host"))
                {
                    <a asp-area="Host" asp-controller="Dashboard" asp-action="Index" class="text-sm font-medium text-gray-700 hover:text-brand">Host Dashboard</a>
                }
                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                {
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-sm font-medium text-gray-700 hover:text-brand">Admin Dashboard</a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @await Component.InvokeAsync("HeaderIcons")
                }
                <partial name="_LoginPartial" />
            </nav>
        </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
        @if (TempData["Success"] is string success)
        {
            <div class="mb-4 rounded-lg bg-green-50 px-4 py-3 text-sm text-green-800">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="mb-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800">@error</div>
        }
        @RenderBody()
    </main>

    <footer class="border-t border-gray-200 py-6 text-center text-sm text-gray-500">
        &copy; 2026 StayBNB
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
