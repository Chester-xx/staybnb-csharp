<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StayBNB</title>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-gray-50 font-sans text-gray-900">
    <header class="border-b border-gray-200 bg-white">
        <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="text-2xl font-bold tracking-tight text-brand">StayBNB</a>
            <nav class="flex items-center gap-4">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="text-sm font-medium text-gray-700 hover:text-brand">Home</a>
                <partial name="_LoginPartial" />
            </nav>
        </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
        @RenderBody()
    </main>

    <footer class="border-t border-gray-200 py-6 text-center text-sm text-gray-500">
        &copy; 2026 StayBNB
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
